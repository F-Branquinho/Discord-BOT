# Everything here is optional: the bot token, client secret and public address
# can be set on the setup page (http://<host>:3000/setup) instead.
# A value set here always wins over the one saved in the panel.

# Bot token: Developer Portal → Bot → Reset Token
BOT_TOKEN=
# OAuth2 client secret, for "Log in with Discord": Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
# Public address of the panel (Cloudflare Tunnel), without a trailing /.
# In Developer Portal → OAuth2 → Redirects, add: <PUBLIC_URL>/callback
PUBLIC_URL=

# Port and interface the panel listens on (point the tunnel here)
WEB_PORT=3000
WEB_HOST=0.0.0.0

# Defaults for new servers (each server can change them in the panel)
TIMEZONE=Europe/Lisbon
CHECK_TIME=00:01
# Language of the birthday message and monthly summary: en or pt
BOT_LANGUAGE=en
# Custom birthday message; leave empty to use the default for the language.
# {user} is replaced by the birthday person's mention.
BIRTHDAY_MESSAGE=
MONTHLY_SUMMARY=true

# Single-server setup without the panel (optional).
# When set, they are moved to that server's settings on first start.
BIRTHDAY_CHANNEL_ID=
GENERAL_CHANNEL_ID=
