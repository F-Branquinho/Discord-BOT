# Obrigatória
BOT_TOKEN=

# Painel web (opcional). Sem estas duas, o painel não arranca.
# PUBLIC_URL é o endereço público (Cloudflare Tunnel), sem / no fim.
# DISCORD_CLIENT_SECRET: Developer Portal → OAuth2 → Client Secret.
# No Developer Portal → OAuth2 → Redirects, adiciona: <PUBLIC_URL>/callback
PUBLIC_URL=
DISCORD_CLIENT_SECRET=
# Porta e interface onde o painel escuta (o túnel aponta para aqui)
WEB_PORT=3000
WEB_HOST=0.0.0.0

# Valores por omissão para servidores novos (cada servidor muda-os no painel)
TIMEZONE=Europe/Lisbon
CHECK_TIME=00:01
# {user} é substituído pela menção ao aniversariante
BIRTHDAY_MESSAGE=🎉 Hoje é o teu dia, {user}! 🎂 Feliz aniversário!
MONTHLY_SUMMARY=true

# Configuração de um só servidor, sem painel (opcional).
# Se estiverem definidos, são passados automaticamente para esse servidor no primeiro arranque.
BIRTHDAY_CHANNEL_ID=
GENERAL_CHANNEL_ID=
