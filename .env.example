# Required
BOT_TOKEN=

# Web panel (optional). Without both of these, the panel doesn't start.
# PUBLIC_URL is the public address (Cloudflare Tunnel), without a trailing /.
# DISCORD_CLIENT_SECRET: Developer Portal → OAuth2 → Client Secret.
# In Developer Portal → OAuth2 → Redirects, add: <PUBLIC_URL>/callback
PUBLIC_URL=
DISCORD_CLIENT_SECRET=
# Port and interface the panel listens on (point the tunnel here)
WEB_PORT=3000
WEB_HOST=0.0.0.0

# Defaults for new servers (each server can change them in the panel)
TIMEZONE=Europe/Lisbon
CHECK_TIME=00:01
# Language of the birthday message and monthly summary: en or pt
BOT_LANGUAGE=en
# Custom birthday message; leave empty to use the default for the language.
# {user} is replaced by the birthday person's mention.
BIRTHDAY_MESSAGE=
MONTHLY_SUMMARY=true

# Single-server setup without the panel (optional).
# When set, they are moved to that server's settings on first start.
BIRTHDAY_CHANNEL_ID=
GENERAL_CHANNEL_ID=
